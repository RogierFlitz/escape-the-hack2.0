# Verplicht op een bereikbare server. Lokaal valt de app terug op flitz-admin.
ADMIN_PASSWORD=kies-een-lang-wachtwoord

# Willekeurige lange string. Ontbreekt die, dan maakt de app data/secret aan.
SESSION_SECRET=

# Zet op true achter HTTPS. Laat uit voor een laptop op het evenement-wifi (http).
COOKIE_SECURE=false

# Leeg = SQLite-bestand in data/game.sqlite (één laptop op locatie).
# Voor meerdere servers: postgres://user:pass@host:5432/escape
DATABASE_URL=

# Zet op true bij een gehoste database die SSL vraagt.
DATABASE_SSL=false
