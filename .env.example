# Verplicht in productie. Zonder deze variabele weigert beheer te openen.
# Lokaal (npm run dev) werkt zonder deze regel; het loginscherm noemt dan het ontwikkelwachtwoord.
ADMIN_PASSWORD=kies-een-lang-wachtwoord

# Willekeurige lange string. Ontbreekt die, dan maakt de app data/secret aan.
SESSION_SECRET=

# Het sessiecookie is Secure op HTTPS en gewoon bruikbaar op HTTP (evenement-wifi).
# Je hoeft daar niets voor te zetten.

# Leeg = SQLite-bestand in data/game.sqlite (één laptop op locatie).
# Voor meerdere servers: postgres://user:pass@host:5432/escape
DATABASE_URL=

# Zet op true bij een gehoste database die SSL vraagt.
DATABASE_SSL=false

# Laat leeg op de evenementlaptop. Zet op true alleen achter een proxy die het echte clientadres zet.
TRUST_PROXY=false

# Demo knoppen blijven uit in een productiebuild, tenzij dit true is en je als instructeur bent ingelogd.
DEMO_TOOLS=false
